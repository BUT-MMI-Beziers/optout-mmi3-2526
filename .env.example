# ── App ──────────────────────────────────────────────────────
NODE_ENV=development

# ── Base de données ──────────────────────────────────────────
# En dev ces valeurs correspondent au container Docker local
# En prod remplacer par les vraies credentials du serveur
DATABASE_URL=postgresql://float:float@db:5432/float
POSTGRES_USER=float
POSTGRES_PASSWORD=float
POSTGRES_DB=float

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── SMTP ──────────────────────────────────────────────────────
# En dev Mailpit intercepte tout, aucun email ne part vraiment
# En prod remplacer par les infos d'un vrai serveur SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@float.local

# ── Chiffrement ───────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne JAMAIS commiter la vraie clé
APP_ENCRYPTION_KEY=optout-dev-key-32chars-minimum!!

# ── Auth JWT ──────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=optout-jwt-secret-dev-key-2026!!
JWT_EXPIRES_IN=7d

# ── Compte administrateur par défaut ──────────────────────────
# Créé automatiquement au premier démarrage (seed). Si ADMIN_PASSWORD
# est absent, aucun compte admin n'est créé. Le compte n'est jamais
# écrasé s'il existe déjà : changer le mot de passe ici n'a d'effet
# qu'avant la première création.
ADMIN_EMAIL=admin@float.local
ADMIN_PASSWORD=changeme-admin-float!

# ── Caddy ─────────────────────────────────────────────────────
API_HOST=api
API_PORT_INTERNAL=3000
FRONT_HOST=front
FRONT_PORT_INTERNAL=5173

# ── Ports ─────────────────────────────────────────────────────
API_PORT=3000
FRONT_PORT=5173